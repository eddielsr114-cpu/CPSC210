{
  "name": "@ubccpsc/210-toolkit",
  "version": "0.0.9",
  "description": "A collection of utilities for CPSC 210.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "vitest",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "Nick Bradley <ncbrad@cs.ubc.ca>",
  "license": "ISC",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "README.md",
    "dist/"
  ],
  "type": "module",
  "types": "dist/index.d.ts",
  "peerDependencies": {
    "vitest": "^4.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./list": {
      "types": "./dist/list.d.ts",
      "default": "./dist/list.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
